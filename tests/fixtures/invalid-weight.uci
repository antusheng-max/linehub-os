config pppoe 'wan_invalid_weight'
	option wan_id 'wan-invalid-weight'
	option username 'fixture@example.invalid'
	option ipv4 '1'
	option ipv6 '1'
	option weight '0'

config pppoe 'wan_weight_too_large'
	option wan_id 'wan-weight-too-large'
	option username 'fixture-large@example.invalid'
	option ipv4 '1'
	option ipv6 '1'
	option weight '101'

config pppoe 'wan_weight_not_numeric'
	option wan_id 'wan-weight-not-numeric'
	option username 'fixture-text@example.invalid'
	option ipv4 '1'
	option ipv6 '1'
	option weight 'heavy'
