config global 'linehub'
	option version '1'
config device 'eth0'
config device 'eth1'
	option ifname 'eth1'
config vlan 'vlan101'
	option device 'eth0'
	option vid '101'
	option ifname 'eth0.101'
config vlan 'vlan202'
	option device 'eth1'
	option vid '202'
	option ifname 'eth1.202'
config pppoe 'alpha'
	option wan_id 'wan-alpha'
	option vlan 'vlan101'
	option username 'alpha@example.invalid'
	option password 'multi-vlan-secret-alpha'
	option macaddr '02:00:00:00:01:01'
	option mac_mode 'generated'
	option ipv4 '1'
	option ipv6 '1'
	option weight '2'
	option healthcheck 'check-alpha'
config pppoe 'beta'
	option wan_id 'wan-beta'
	option vlan 'vlan202'
	option username 'beta@example.invalid'
	option password 'multi-vlan-secret-beta'
	option macaddr '02:00:00:00:02:01'
	option mac_mode 'generated'
	option ipv4 '0'
	option ipv6 '1'
	option weight '1'
	option healthcheck 'check-beta'
config lan 'main'
	option ipv4_cidr '192.0.2.1/24'
	option ula_prefix 'fd42:4c69:6e65::/48'
config pool 'default'
	list member 'wan-alpha'
	list member 'wan-beta'
config healthcheck 'check-alpha'
	option wan 'wan-alpha'
config healthcheck 'check-beta'
	option wan 'wan-beta'
config policy 'lan-default'
	option pool 'default'
